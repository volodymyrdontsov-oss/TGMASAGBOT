# Telegram API credentials (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The specialist name to monitor (case-insensitive substring match)
SPECIALIST_NAME=

# How often to check for new slots (in seconds, default: 60)
CHECK_INTERVAL=60

# Notification settings
# Option 1: Send to your own "Saved Messages" (default, no config needed)
# Option 2: Use a separate bot to send notifications
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# Text that indicates no slots are available (if the bot's response contains
# this text, no alert is sent). Default works for GenesisMassagesBot.
NO_SLOTS_TEXT=Немає вільних слотів

# The username of the massage booking bot (without @)
MASSAGE_BOT_USERNAME=GenesisMassagesBot

# Session file name (without extension)
SESSION_NAME=massage_monitor_session
